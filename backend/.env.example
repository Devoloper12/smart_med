# Server Configuration (Render automatically sets PORT)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_medicine_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=smart_medicine_super_secret_jwt_key_2026_render_production

# Frontend Client URL for CORS (e.g., https://your-project.vercel.app or * for all)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,https://*.vercel.app

# Uploads directory
UPLOAD_DIR=uploads/prescriptions
